{
  "permissions": {
    "deny": [
      "Read(secrets.properties)",
      "Read(local.properties)",
      "Read(.env*)",
      "Read(*.jks)",
      "Read(*.keystore)",
      "Read(*.p12)",
      "Read(*.pem)",
      "Read(google-services.json)",
      "Read(GoogleService-Info.plist)",
      "Read(**/Secrets.xcconfig)",
      "Read(**/mapbox_access_token.xml)",
      "Read(**/build/generated/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | { read -r f; git add -N \"$f\"; } 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
