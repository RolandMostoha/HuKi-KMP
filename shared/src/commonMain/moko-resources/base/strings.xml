    <string name="gpx_tutorial_a11y_back">Back</string>
    <string name="gpx_tutorial_what_title">What is a GPX file?</string>
    <string name="gpx_tutorial_what_message">A GPX file stores a route as a line. It’s a well-known, open format that hikers use to record their routes and follow trails.</string>
    <string name="gpx_tutorial_steps_section">How to import GPX into HuKi</string>
    <string name="gpx_tutorial_step_1_title">Browse a hike collection website</string>
    <string name="gpx_tutorial_step_1_message">My favorites:</string>
    <string name="gpx_tutorial_step_2_title">Look for GPX export/download option</string>
    <string name="gpx_tutorial_step_2_message">It’s usually near the route map. Logging in may be required.</string>
    <string name="gpx_tutorial_step_3_title">Download the GPX file to your phone</string>
    <string name="gpx_tutorial_step_3_message">Save it from the website — it lands in Files or Downloads.</string>
    <string name="gpx_tutorial_step_4_title">Open the file with HuKi</string>
    <string name="gpx_tutorial_step_4_message">Tap the GPX file, choose Share, then pick HuKi. The route appears in your GPX Collection.</string>
