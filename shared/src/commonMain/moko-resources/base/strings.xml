    <string name="slope_legend_climb_steep">Steep climb</string>

    <string name="trail_symbols_guide_title">Trail Symbols</string>
    <string name="trail_symbols_guide_a11y_back">Back</string>
    <string name="trail_symbols_main_section_title">Route trail markings</string>
    <string name="trail_symbols_colors_section_title">Colors</string>
    <string name="trail_symbols_branch_section_title">Destination trail markings</string>
    <string name="trail_symbols_blue_title">Blue stripe</string>
    <string name="trail_symbols_blue_description">Marks the most important, nationally significant routes, and the main route of certain regions.</string>
    <string name="trail_symbols_red_title">Red stripe</string>
    <string name="trail_symbols_red_description">Trails crossing at least one region, as well as locally prominent routes.</string>
    <string name="trail_symbols_yellow_title">Yellow stripe</string>
    <string name="trail_symbols_yellow_description">Marks locally important backbone network routes.</string>
    <string name="trail_symbols_green_title">Green stripe</string>
    <string name="trail_symbols_green_description">Marks minor, local routes.</string>
    <string name="trail_symbols_stripe_colors_title">Colors</string>
    <string name="trail_symbols_stripe_colors_description">The trail marking colors show the type of the route (national, regional, local), not its difficulty. For a destination marking, the color shows which route it branches off from.</string>
    <string name="trail_symbols_cross_title">Cross</string>
    <string name="trail_symbols_cross_description">A crossing point in the connections between blue, red, yellow or green stripes.</string>
    <string name="trail_symbols_round_tour_title">Round tour</string>
    <string name="trail_symbols_round_tour_description">Marks easier, 2–10 km trails that return to their starting point.</string>
    <string name="trail_symbols_educational_trail_title">Educational trail</string>
    <string name="trail_symbols_educational_trail_description">Marks shorter, educational routes usually made up of several stations.</string>
    <string name="trail_symbols_triangle_title">Triangle</string>
    <string name="trail_symbols_triangle_description">High point, hilltop, peak, natural viewpoint.</string>
    <string name="trail_symbols_square_title">Square</string>
    <string name="trail_symbols_square_description">Leads to a settlement, accommodation or transport option.</string>
    <string name="trail_symbols_circle_title">Circle</string>
    <string name="trail_symbols_circle_description">Leads to a spring, well or other water source.</string>
    <string name="trail_symbols_cave_title">Cave</string>
    <string name="trail_symbols_cave_description">Leads to a cave or cave entrance.</string>
