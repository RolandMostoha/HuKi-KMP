    <string name="gpx_tutorial_step_2_message">Általában az útvonal térképe mellett található. Előfordulhat, hogy regisztrációhoz kötött.</string>
    <string name="gpx_tutorial_step_3_title">Töltsd le a GPX fájlt a telefonodra</string>
    <string name="gpx_tutorial_step_3_message">Mentsd el a weboldalról — a Fájlok vagy a Letöltések közé kerül.</string>
    <string name="gpx_tutorial_step_4_title">Nyisd meg a fájlt a HuKi-val</string>
    <string name="gpx_tutorial_step_4_message">Koppints a GPX fájlra, válaszd a Megosztást, majd a HuKi-t. Az útvonal ezután megjelenik a GPX gyűjteményedben.</string>
